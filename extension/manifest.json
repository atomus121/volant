{
  "manifest_version": 3,
  "name": "Volant 下载捕获",
  "version": "0.6.16",
  "description": "把浏览器的下载交给 Volant：带上 Cookie / Referer，继续用浏览器的登录身份下载。",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "volant@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["downloads", "cookies", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Volant 下载捕获",
    "default_popup": "popup.html"
  }
}
