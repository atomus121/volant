// Volant M0 · Slint 路线原型
// 视觉规格与 egui-proto 逐项对齐：同一套颜色、行高 52、字号 14.5/13、同样的三段结构。

import { ListView } from "std-widgets.slint";

export struct RowItem {
    name: string,
    size-text: string,
    speed-text: string,
    speed-color: color,
    progress: float,
    bar-color: color,
}

component RowView inherits Rectangle {
    callback picked();

    in property <RowItem> data;
    in property <bool> is-selected;

    height: 52px;
    background: is-selected ? #1C2026 : (ta.has-hover ? #16181C : transparent);

    ta := TouchArea {
        clicked => {
            root.picked();
        }
    }

    // 选中标记：左侧 2px 强调色条
    Rectangle {
        visible: is-selected;
        x: 0;
        y: 0;
        width: 2px;
        height: parent.height;
        background: #4C8DFF;
    }

    Text {
        x: 20px;
        y: 0;
        width: max(0px, parent.width - 20px - 84px - 96px - 20px);
        height: parent.height - 4px;
        text: data.name;
        color: #F2F3F5;
        font-size: 14.5px;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 20px - 84px - 96px;
        y: 0;
        width: 96px;
        height: parent.height - 4px;
        text: data.speed-text;
        color: data.speed-color;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 20px - 84px;
        y: 0;
        width: 84px;
        height: parent.height - 4px;
        text: data.size-text;
        color: #8A8F98;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // 底部 1.5px 进度线
    Rectangle {
        x: 20px;
        y: parent.height - 3px;
        width: max(0px, parent.width - 40px);
        height: 1.5px;
        background: #1A1D22;

        Rectangle {
            width: parent.width * min(1.0, max(0.0, data.progress));
            height: parent.height;
            background: data.bar-color;
        }
    }
}

export component MainWindow inherits Window {
    in property <[RowItem]> rows;
    in-out property <int> selected: 1;
    in-out property <length> scroll-y: 0px;
    in property <string> detail-name: "";
    in property <string> detail-meta: "";
    in property <string> detail-status: "";
    in property <color> detail-status-color: #8A8F98;

    callback pick(int);

    width: 780px;
    height: 470px;
    title: "Volant";
    background: #0B0C0E;

    VerticalLayout {
        spacing: 0px;

        // ── 顶栏 56px ──
        Rectangle {
            height: 56px;
            background: #0D0E11;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: LayoutAlignment.space-between;

                Text {
                    text: "Volant";
                    color: #F2F3F5;
                    font-size: 16.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: LayoutAlignment.end;

                    Text {
                        text: "⚙";
                        color: #8A8F98;
                        font-size: 17px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "+";
                        color: #8A8F98;
                        font-size: 19px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #4C8DFF;
                    }
                }
            }
        }

        // ── 列表（ListView 内置虚拟化） ──
        ListView {
            content-y: root.scroll-y;

            for item[idx] in root.rows : RowView {
                data: item;
                is-selected: idx == root.selected;
                picked => {
                    root.selected = idx;
                    root.pick(idx);
                }
            }
        }

        // ── 底部详情 88px ──
        Rectangle {
            height: 88px;
            background: #0D0E11;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                alignment: LayoutAlignment.space-between;

                Text {
                    text: root.detail-name;
                    color: #F2F3F5;
                    font-size: 15px;
                    overflow: elide;
                }

                Text {
                    text: root.detail-status;
                    color: root.detail-status-color;
                    font-size: 13px;
                }
            }

            Text {
                x: 20px;
                y: 44px;
                width: max(0px, parent.width - 40px);
                text: root.detail-meta;
                color: #8A8F98;
                font-size: 13px;
                overflow: elide;
            }
        }
    }
}
